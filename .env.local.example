# xAI Responses API key (Grok 4.6, web_search, x_search) — required
# Recommended lookup (do not paste the key into chat or git):
#   GROK_API_KEY=$(security find-generic-password -a "username" -s "xai_api" -w)
GROK_API_KEY=

# Semantic Scholar API key — optional. Improves /paper/search rate limits.
# Anonymous search may 429 on shared wifi; a 403 key is ignored after one
# anonymous retry. Academic failure is an error node, not a hard stop.
# Free key: https://www.semanticscholar.org/product/api
# Recommended lookup (do not paste the key into chat or git):
#   SEMANTIC_SCHOLAR_API_KEY=$(security find-generic-password -a "$USER" -s "semantic_scholar" -w)
SEMANTIC_SCHOLAR_API_KEY=

# Bearer token required by app/api/mcp (hosted MCP endpoint). Anyone with
# this token can spend GROK_API_KEY / SEMANTIC_SCHOLAR_API_KEY through it.
# Set the same value in the Vercel project env and in Cursor's mcp.json
# (${env:SCOUT_MCP_TOKEN}) — never commit the actual value.
SCOUT_MCP_TOKEN=
